rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    // Checks if the user is authenticated and their UID exists in the 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins Collection
    // STRICT: Only admins can read or write to this collection
    match /admins/{userId} {
      allow read, write: if isAdmin();
    }

    // Barber Applications Collection
    match /barber_applications/{barberId} {
      // READ:
      // 1. Admins have full read access
      // 2. Barbers can read their own application data
      // 3. Authenticated users (Customers) can read public data of APPROVED barbers
      allow read: if isAdmin() 
                  || (isAuthenticated() && request.auth.uid == barberId)
                  || (isAuthenticated() && resource.data.status == 'approved');

      // WRITE:
      // STRICT: Only admins can update status or details.
      // Barbers are explicitly READ-ONLY for now (Phase B).
      allow write: if isAdmin();
    }

    // Admin Logs Collection
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.barberId == request.auth.uid);
      // STRICT: Client apps CANNOT write to bookings. All mutations go through Cloud Functions.
      allow write: if false; 
    }

    // Reviews Collection (Phase D)
    match /reviews/{reviewId} {
      // READ: Anyone can read visible reviews. Admins can read all.
      allow read: if isAdmin() || resource.data.visibility == 'VISIBLE';
      // STRICT: Managed by Cloud Functions to ensure valid booking linking.
      allow write: if false;
    }

    // Wallets & Transactions (Phase 1 Protection)
    match /wallets/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if false; // Cloud Functions Only
    }

    match /transactions/{txId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow write: if false; // Cloud Functions Only
    }

    // Geo-Zones Collection (Phase E)
    match /geo_zones/{zoneId} {
      // READ: Any authenticated user can see zone statuses (demand/supply control)
      allow read: if isAuthenticated();
      // Admin only via Admin App (Low risk compared to bookings/wallets)
      allow write: if isAdmin();
    }

    // Platform Configuration
    match /platform/config {
      allow read, write: if isAdmin();
    }

    // Notifications Collection (Phase 2)
    match /notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Cloud Functions or Admin App
    }

    // Disputes (Phase 3)
    match /disputes/{disputeId} {
      allow read: if isAdmin() || (isAuthenticated() && (request.auth.uid == resource.data.reporterId || request.auth.uid == resource.data.targetId));
      allow write: if false; // Functions only
    }

    // Enforcement Logs (Phase 3)
    match /admin_enforcement_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; 
    }

    // Default: Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
