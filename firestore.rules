rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Admins Collection
    // Relaxed read to allow the app to check admin status during startup/login
    match /admins/{userId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if true; // Relaxed for profile lookups and searches
      allow write: if isAuthenticated() && request.auth.uid == customerId;
      allow update, delete: if isAdmin();
    }

    // Users Collection (shared with the Flutter app)
    // Admins mirror approval status here so the mobile app can read it.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // Barber Applications Collection
    // Note: Barbers use this for their primary profile/status in both apps
    match /barber_applications/{barberId} {
      allow read: if true; // Public access for browsing approved barbers or checking own status
      allow write: if isAuthenticated() && request.auth.uid == barberId; 
      allow update, delete: if isAdmin();
    }

    // Admin Logs Collection
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isAuthenticated(); // Allow logging from authenticated context if app requires it
      allow update, delete: if false;
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.barberId == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.barberId == request.auth.uid);
    }

    // Platform Configuration
    // CRITICAL: Must be readable for splash screen and initialization logic
    match /platform/config {
      allow read: if true; 
      allow write: if isAdmin(); 
      
      match /versions/{versionId} {
        allow read: if isAdmin();
        allow write: if false; 
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated(); // Allow notification check
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    // Geo-Zones
    match /geo_zones/{zoneId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: Deny access to all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
